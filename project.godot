; Fichier de configuration du projet Godot 4.
; Ouvrez ce dossier avec Godot 4.3 (ou plus récent) pour modifier le jeu.

config_version=5

[application]

config/name="Movie Manager 2027"
config/description="Jeu de gestion d'un studio de production de cinéma."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
